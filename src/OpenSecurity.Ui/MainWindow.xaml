<Window x:Class="OpenSecurity.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OpenSecurity" Height="780" Width="1040" MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <DataTemplate x:Key="ScanRowTemplate">
            <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="10,8">
                <Expander IsEnabled="{Binding HasFindings}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{Binding Verdict, Converter={StaticResource VerdictToBrushConverter}}"
                                    CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Verdict, Converter={StaticResource VerdictToIconConverter}}"
                                               FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#FF14141A" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding VerdictLabel}" FontSize="11" FontWeight="Bold" Foreground="#FF14141A" />
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Column="1" Text="{Binding FilePath}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="2" Text="{Binding SizeLabel}"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Visibility="{Binding ShowActions, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Quarantine" FontSize="11" Padding="8,4" Tag="{Binding}" Click="Quarantine_Click" />
                                <Button Content="Allow" FontSize="11" Padding="8,4" Margin="6,0,0,0" Tag="{Binding}" Click="Allow_Click" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <ItemsControl ItemsSource="{Binding Findings}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="16,3,0,3">
                                    <TextBlock Text="{Binding Source, StringFormat='[{0}]'}"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="OpenSecurity" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="on-demand malware scanner" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,4,0,0" />
            </StackPanel>
            <TextBlock Text="by Nolan Crowley  ·  Open Source (MIT License)" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="20,4,0,0" />
        </StackPanel>

        <!-- Target picker -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PathTextBox" Grid.Column="0" VerticalContentAlignment="Center"
                         Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Type a file or folder path, or drag &amp; drop it onto this window" />

                <Button Grid.Column="1" Content="Browse Folder" Margin="10,0,0,0" Click="BrowseFolder_Click" />
                <Button Grid.Column="2" Content="Browse File" Margin="8,0,0,0" Click="BrowseFile_Click" />
                <CheckBox Grid.Column="3" Content="Recursive" IsChecked="{Binding IsRecursive}"
                          VerticalAlignment="Center" Margin="14,0,0,0" />
                <Button Grid.Column="4" Style="{StaticResource AccentButton}" Content="Scan" Margin="14,0,0,0"
                        Width="90" Click="Scan_Click" IsEnabled="{Binding CanScan}" />
            </Grid>
        </Border>

        <!-- Drag hint + full-drive scan -->
        <Grid Grid.Row="2" Margin="4,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="or drag &amp; drop a file or folder anywhere on this window"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Scan full drive:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ItemsControl ItemsSource="{Binding AvailableDrives}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" FontSize="11" Padding="8,4" Margin="0,0,6,0" Tag="{Binding}" Click="ScanDrive_Click" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- Signature database / update bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                    <Run Text="{Binding HashSignatureCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="hash signatures  ·" />
                    <Run Text="{Binding RuleCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="rules  ·" />
                    <Run Text="{Binding AllowlistCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="allowlisted" />
                </TextBlock>

                <TextBox Grid.Column="1" Margin="14,0" VerticalContentAlignment="Center"
                         Text="{Binding UpdateFeedUrl, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Plaintext SHA-256 hash feed URL (e.g. abuse.ch MalwareBazaar export)" />

                <Button Grid.Column="2" Content="Update Signatures" Click="UpdateSignatures_Click"
                        IsEnabled="{Binding IsUpdatingSignatures, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>
        </Border>

        <!-- Summary strip -->
        <Grid Grid.Row="4" Margin="0,16,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource CleanBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding CleanCount, StringFormat='Clean {0}'}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuspiciousBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SuspiciousCount, StringFormat='Suspicious {0}'}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource MaliciousBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding MaliciousCount, StringFormat='Malicious {0}'}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ErrorCount, StringFormat='Errors {0}'}" />
                </StackPanel>
            </Border>

            <Button Grid.Column="4" Content="Export Report" FontSize="11" Padding="10,6"
                    IsEnabled="{Binding CanExport}" Click="ExportReport_Click" />

            <TextBlock Grid.Column="6" Text="{Binding ElapsedLabel}" Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="7" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Scan sweep - the one signature motion cue, tied to the app's core action -->
        <Border Grid.Row="5" Height="3" Margin="0,0,0,8" CornerRadius="2" Background="{StaticResource SurfaceAltBrush}"
                ClipToBounds="True" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
            <Border x:Name="SweepBar" Width="160" HorizontalAlignment="Left" CornerRadius="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="{StaticResource AccentColor}" Offset="0.5" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SweepTransform" X="-160" />
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SweepTransform" Storyboard.TargetProperty="X"
                                                 From="-160" To="1000" Duration="0:0:1.4" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="6">
            <TabItem Header="Scan Results">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="8" Margin="0,8,0,0">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                            <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource ScanRowTemplate}" />
                        </ScrollViewer>
                        <TextBlock Text="No scans yet - pick a file or folder above and hit Scan, or drag one onto this window."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                                   Visibility="{Binding Results.Count, Converter={StaticResource EmptyCollectionToVisibility}}" />
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="{Binding QuarantineEntries.Count, StringFormat='Quarantine ({0})'}">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="8" Margin="0,8,0,0">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                            <ItemsControl ItemsSource="{Binding QuarantineEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding OriginalPath}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                        <Run Text="{Binding Reason, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding TimestampLabel, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="Restore" FontSize="11" Padding="8,4" Tag="{Binding}" Click="RestoreQuarantine_Click" />
                                                    <Button Content="Delete" FontSize="11" Padding="8,4" Margin="6,0,0,0" Tag="{Binding}" Click="DeleteQuarantine_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="Nothing in quarantine - files you quarantine will show up here, and can be restored anytime."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                                   Visibility="{Binding QuarantineEntries.Count, Converter={StaticResource EmptyCollectionToVisibility}}" />
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="History">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="8" Margin="0,8,0,0">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                            <ItemsControl ItemsSource="{Binding HistoryEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="10,8">
                                            <Expander IsEnabled="{Binding HasFlaggedFiles}">
                                                <Expander.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TargetPath}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                            <Run Text="{Binding TimestampLabel, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding SummaryLabel, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Expander.Header>

                                                <ItemsControl ItemsSource="{Binding FlaggedFiles}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="16,3,0,3">
                                                                <TextBlock Text="{Binding Verdict, StringFormat='[{0}]'}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding FilePath}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding TopFinding}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="No scan history yet - run your first scan to start building a record."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                                   Visibility="{Binding HistoryEntries.Count, Converter={StaticResource EmptyCollectionToVisibility}}" />
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Real-Time Protection">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Enable real-time protection" IsChecked="{Binding IsRealTimeProtectionEnabled}"
                                          VerticalAlignment="Center" />
                                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"
                                          VerticalAlignment="Center" Margin="24,0,0,0" />
                                <CheckBox Content="'Scan with OpenSecurity' right-click menu" IsChecked="{Binding IsContextMenuEnabled}"
                                          VerticalAlignment="Center" Margin="24,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Watches the folders below and automatically scans new or changed files as they appear. User-mode only - not a kernel driver. The right-click menu adds a Scan with OpenSecurity entry to Explorer for files, folders, and drives (opens this window and scans immediately)."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,10" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Watched folders" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Content="Add Folder" FontSize="11" Padding="8,4" Margin="10,0,0,0" Click="AddWatchedFolder_Click" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding WatchedFolders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Remove" FontSize="11" Padding="8,4" Tag="{Binding}" Click="RemoveWatchedFolder_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                                <ItemsControl ItemsSource="{Binding RealTimeDetections}" ItemTemplate="{StaticResource ScanRowTemplate}" />
                            </ScrollViewer>
                            <TextBlock Text="No detections yet - files landing in your watched folders are scanned automatically and will show up here if anything's flagged."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                                       Visibility="{Binding RealTimeDetections.Count, Converter={StaticResource EmptyCollectionToVisibility}}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Schedule">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Runs a scan automatically via Windows Task Scheduler, even when OpenSecurity isn't open."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap" />

                        <TextBlock Text="Folder to scan" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" VerticalContentAlignment="Center"
                                     Text="{Binding ScheduleTargetPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="BrowseScheduleFolder_Click" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <CheckBox Content="Weekly (every Sunday) - unchecked means Daily" IsChecked="{Binding ScheduleIsWeekly}"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Time (24h, HH:mm)" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Width="100" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                                 Text="{Binding ScheduleTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                        <CheckBox Content="Automatically quarantine malicious files found" IsChecked="{Binding ScheduleQuarantine}" Margin="0,0,0,14" />

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Content="Enable Schedule" Click="EnableSchedule_Click" />
                            <Button Content="Disable Schedule" Margin="10,0,0,0" Click="DisableSchedule_Click" />
                            <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Status:" />
                                <Run Text="{Binding IsScheduleEnabled, Mode=OneWay, StringFormat={}{0}}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

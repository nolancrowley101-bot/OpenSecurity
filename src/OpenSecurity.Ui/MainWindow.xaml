<Window x:Class="OpenSecurity.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OpenSecurity" Height="740" Width="1000" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="OpenSecurity" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="on-demand malware scanner" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,4,0,0" />
            </StackPanel>
            <TextBlock Text="by Nolan Crowley  ·  Open Source (MIT License)" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="20,4,0,0" />
        </StackPanel>

        <!-- Target picker -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PathTextBox" Grid.Column="0" VerticalContentAlignment="Center"
                         Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Type a file or folder path, or drag &amp; drop it onto this window" />

                <Button Grid.Column="1" Content="Browse Folder" Margin="10,0,0,0" Click="BrowseFolder_Click" />
                <Button Grid.Column="2" Content="Browse File" Margin="8,0,0,0" Click="BrowseFile_Click" />
                <CheckBox Grid.Column="3" Content="Recursive" IsChecked="{Binding IsRecursive}"
                          VerticalAlignment="Center" Margin="14,0,0,0" />
                <Button Grid.Column="4" Style="{StaticResource AccentButton}" Content="Scan" Margin="14,0,0,0"
                        Width="90" Click="Scan_Click" IsEnabled="{Binding CanScan}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="or drag &amp; drop a file or folder anywhere on this window"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="4,6,0,0" />

        <!-- Signature database / update bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                    <Run Text="{Binding HashSignatureCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="hash signatures  ·" />
                    <Run Text="{Binding RuleCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="rules  ·" />
                    <Run Text="{Binding AllowlistCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="allowlisted" />
                </TextBlock>

                <TextBox Grid.Column="1" Margin="14,0" VerticalContentAlignment="Center"
                         Text="{Binding UpdateFeedUrl, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Plaintext SHA-256 hash feed URL (e.g. abuse.ch MalwareBazaar export)" />

                <Button Grid.Column="2" Content="Update Signatures" Click="UpdateSignatures_Click"
                        IsEnabled="{Binding IsUpdatingSignatures, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>
        </Border>

        <!-- Summary strip -->
        <Grid Grid.Row="4" Margin="0,16,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource CleanBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding CleanCount, StringFormat='Clean {0}'}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuspiciousBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SuspiciousCount, StringFormat='Suspicious {0}'}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource MaliciousBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding MaliciousCount, StringFormat='Malicious {0}'}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ErrorCount, StringFormat='Errors {0}'}" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="5" Text="{Binding ElapsedLabel}" Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="6" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Scan results / Quarantine -->
        <TabControl Grid.Row="5">
            <TabItem Header="Scan Results">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="8" Margin="0,8,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="10,8">
                                        <Expander IsEnabled="{Binding HasFindings}">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="{Binding Verdict, Converter={StaticResource VerdictToBrushConverter}}"
                                                            CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding VerdictLabel}" FontSize="11" FontWeight="Bold" Foreground="#FF14141A" />
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding FilePath}" VerticalAlignment="Center"
                                                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Grid.Column="2" Text="{Binding SizeLabel}"
                                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Visibility="{Binding ShowActions, Converter={StaticResource BoolToVisibility}}">
                                                        <Button Content="Quarantine" FontSize="11" Padding="8,4" Tag="{Binding}" Click="Quarantine_Click" />
                                                        <Button Content="Allow" FontSize="11" Padding="8,4" Margin="6,0,0,0" Tag="{Binding}" Click="Allow_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>

                                            <ItemsControl ItemsSource="{Binding Findings}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="16,3,0,3">
                                                            <TextBlock Text="{Binding Source, StringFormat='[{0}]'}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="{Binding QuarantineEntries.Count, StringFormat='Quarantine ({0})'}">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="8" Margin="0,8,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                        <ItemsControl ItemsSource="{Binding QuarantineEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding OriginalPath}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                    <Run Text="{Binding Reason, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding TimestampLabel, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Restore" FontSize="11" Padding="8,4" Tag="{Binding}" Click="RestoreQuarantine_Click" />
                                                <Button Content="Delete" FontSize="11" Padding="8,4" Margin="6,0,0,0" Tag="{Binding}" Click="DeleteQuarantine_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
